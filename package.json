{
  "name": "prime-trail",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:slow": "vitest run -c vitest.slow.config.ts",
    "test:e2e": "playwright test",
    "build": "vite build",
    "deploy": "pnpm build && wrangler deploy",
    "gen:levels": "tsx scripts/gen-levels.ts",
    "gen:pdf-font": "tsx scripts/gen-pdf-font.ts"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "bootstrap": "^5.3.8",
    "jspdf": "^4.2.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "fast-check": "^4.10.2",
    "fontkit": "^2.0.4",
    "jsdom": "^30.1.3",
    "sass-embedded": "^1.106.1",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  }
}
